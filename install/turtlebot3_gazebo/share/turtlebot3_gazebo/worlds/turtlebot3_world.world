<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="default">
    <!-- Sol -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Soleil -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Robot -->
    <include>
      <uri>model://turtlebot3_burger</uri>
    </include>

    <!-- Cube rouge -->
    <model name="red_cube">
      <pose>1 0 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>1 0 0 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Cube bleu -->
    <model name="blue_cube">
      <pose>-1 0 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0 0 1 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
